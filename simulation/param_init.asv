%% param_init.m
% Parameter file for Madgwick + Kalman Filter vertical speed estimator
% Hardware: SLP06001 barometer + LSM6DS3 IMU
clear slBus1 slBus1_baro
% clear;
% close all;

%% =========================================================
%  1. SAMPLE RATES & TIMING
% ==========================================================
param.dt_imu   = 1/52;
param.dt_baro  = 1/8;
param.dt_sim   = param.dt_imu;

%% =========================================================
%  2. SLP06001 BAROMETER NOISE MODEL
% ==========================================================
param.baro.sigma_p  = 0.5;
param.baro.rho0     = 1.225;
param.baro.g        = 9.80665;
param.baro.sigma_h  = param.baro.sigma_p / (param.baro.rho0 * param.baro.g);
param.baro.R_baro   = param.baro.sigma_h^2;
param.baro.T0       = 288.15;
param.baro.L        = 0.0065;
param.baro.p0       = 101325;

%% =========================================================
%  3. LSM6DS3 IMU NOISE MODEL
% ==========================================================
param.imu.accel_noise_density = 90e-6 * 9.80665;
param.imu.gyro_noise_density  = 7e-3  * (pi/180);
param.imu.ODR                 = 104;
param.imu.bandwidth           = param.imu.ODR / 2;
param.imu.sigma_a = param.imu.accel_noise_density * sqrt(param.imu.bandwidth);
param.imu.sigma_g = param.imu.gyro_noise_density  * sqrt(param.imu.bandwidth);
param.imu.bias_instability_a  = 40e-6 * 9.80665;
param.imu.bias_instability_g  = 5e-3  * (pi/180);
param.imu.sigma_ba0 = 5e-3 * 9.80665;
param.imu.sigma_bg0 = 0.5  * (pi/180);

%% =========================================================
%  4. MADGWICK FILTER PARAMETERS
% =========================================================
%
%  beta: gradient-descent step size [rad/s]
%  ----------------------------------------
%  From Madgwick (2010): beta = sqrt(3/4) * gyro_meas_error
%  gyro_meas_error is the expected gyro measurement error in rad/s,
%  which is NOT the white noise sigma — it includes dynamic errors
%  (vibration, integration drift) and is typically set to ~5°/s:
%    beta = sqrt(3/4) * (5 * pi/180) = 0.076
%
%  A value of beta=0.8 (as previously set) is ~10x too large.
%  At 52 Hz with beta=0.8, the accel gradient correction moves
%  the quaternion by 0.8/52 ≈ 15 mrad/sample, completely
%  overwhelming the gyro integral during manoeuvres (where accel
%  ≠ gravity). This is why the estimate diverges after ~20 s
%  when the thermal circling phase begins.
%
%  Rule of thumb: beta should be large enough to prevent slow gyro
%  drift over minutes, but small enough that during a 20°/s bank
%  manoeuvre (centripetal accel ≈ 0.3g) the gradient step doesn't
%  corrupt the attitude estimate.
%
param.madgwick.beta = 0.5;   % sqrt(3/4) * (2.7 deg/s) — tuned for LSM6DS3
                                % Start here; reduce if still noisy in turns,
                                % increase if slow to converge from cold start.

%  zeta: gyro bias drift compensation [rad/s²]
%  --------------------------------------------
%  Integrates the gradient to estimate slow gyro bias.
%  Must be << beta to avoid instability. Typical: zeta ≈ beta/10.
param.madgwick.zeta = 0.004;

param.madgwick.dt   = param.dt_imu;
param.madgwick.q0   = [1 0 0 0];   % identity: body aligned with NED at t=0

%  g_ref: gravity reference in BODY frame (unit vector)
%  ------------------------------------------------------
%  Body Z is DOWN => gravity (+g) points along +body_Z.
%  The sensor however reads the reaction: f_body = -g at rest.
%  This vector is used only as documentation; the objective function
%  in fcn_madgwick.m encodes the sensor reading directly (see header).
param.madgwick.g_ref = [0; 0; -1];  % normalised sensor reading at rest
                                      % (body Z down, sensor reads -g direction)

%% =========================================================
%  5. KALMAN FILTER PARAMETERS
%  State: x = [h; vz; az_bias]
% ==========================================================
dt  = param.dt_imu;
sa2 = param.imu.sigma_a^2;
% Also, consider increasing your bias walk noise (sb2) 
% so the bias state can "track" the tilt error faster.
sb2 = (0.05)^2;

param.kf.q_az   = sa2 / dt;
param.kf.q_bias = sb2;
% Increase q_az to account for orientation errors (not just sensor noise)
% We add a term for "modeling error"
modeling_error_sigma = 0.2; % m/s2 - allowance for Madgwick tilt errors
total_sigma_a = sqrt(param.imu.sigma_a^2 + modeling_error_sigma^2);

param.kf.Q = [ total_sigma_a^2*dt^3/3,  total_sigma_a^2*dt^2/2,  0;
               total_sigma_a^2*dt^2/2,  total_sigma_a^2*dt,       0;
               0,                        0,            sb2*dt ];


param.kf.R_h  = param.baro.R_baro;
param.kf.P0   = diag([5^2, 2^2, param.imu.sigma_ba0^2]);
param.kf.x0   = [0; 0; 0];
param.kf.F    = [1,  dt,  -dt^2/2;
                 0,  1,   -dt;
                 0,  0,    1     ];
param.kf.B    = [dt^2/2; dt; 0];
param.kf.H    = [1, 0, 0];
param.kf.gate_threshold = 10.83;

%% =========================================================
%  6. COORDINATE CONVENTIONS
% ==========================================================
%  Body frame : X=forward, Y=right, Z=DOWN  (LSM6DS3 default)
%  World frame: NED
%  vz positive: UP (opposite NED-Z)
%  az_world   : NED-Down specific force; ≈ -g at rest
%  a_up       : -(az_world + g) fed to Kalman; ≈ 0 at rest
param.coord.R_mount = eye(3);

%% =========================================================
%  7. SIMULATION CONTROL
% ==========================================================
param.sim.t_end = 600;
param.sim.g     = 9.80665;

%% =========================================================
%  8. SIMULINK BUS
% ==========================================================
Simulink.Bus.createObject(param);
BusKF = slBus1;


fprintf('param_init loaded.\n');
fprintf('  IMU rate   : %.0f Hz\n',   1/param.dt_imu);
fprintf('  Baro rate  : %.0f Hz\n',   1/param.dt_baro);
fprintf('  sigma_h    : %.4f m\n',    sqrt(param.kf.R_h));
fprintf('  sigma_a    : %.5f m/s2\n', param.imu.sigma_a);
fprintf('  Madgwick β : %.4f  (was 0.8 — reduced 20x)\n', param.madgwick.beta);
fprintf('  Madgwick ζ : %.4f\n',      param.madgwick.zeta);
fprintf('Bus object ''BusKF'' created.\n');

%% Load trajectory
% trajectory_paraglider;