%% unit_test_madgwick.m
% Traces the Madgwick objective function with known exact values to find
% the sign error. No Simulink, no trajectory — just algebra checks.
%
% Run this standalone. It does not need param_init.

fprintf('=== Madgwick unit test ===\n\n');

g = 9.80665;

%% =========================================================
%  TEST 1 — Static check at identity quaternion
%  At rest, level, body Z down:
%    accel reads [0, 0, -g]  (reaction to gravity)
%    gyro  reads [0, 0,  0]
%    correct az_world = -g
%    correct a_up     =  0
% ==========================================================
fprintf('--- TEST 1: identity quaternion, sensor at rest ---\n');
q = [1 0 0 0];   % identity: body aligned with NED
ax = 0; ay = 0; az = -g;   % body Z down, sensor reads -g

% Normalise
an = sqrt(ax^2+ay^2+az^2);
axn=ax/an; ayn=ay/an; azn=az/an;
fprintf('  axn=%.4f  ayn=%.4f  azn=%.4f  (expect 0, 0, -1)\n', axn,ayn,azn);

w=q(1); x=q(2); y=q(3); z=q(4);

% Objective function (current implementation)
F1 = -2.0*(w*y - x*z) - axn;   % R31 = 2(wy-xz), expected = -R31
F2 = -2.0*(y*z + w*x) - ayn;   % R32 = 2(yz+wx), expected = -R32
F3 = -(w^2 - x^2 - y^2 + z^2) - azn;
fprintf('  F1=%.4f  F2=%.4f  F3=%.4f  (all must be 0)\n', F1,F2,F3);
if abs(F1)<1e-9 && abs(F2)<1e-9 && abs(F3)<1e-9
    fprintf('  TEST 1: PASS\n\n');
else
    fprintf('  TEST 1: FAIL — objective is nonzero at rest!\n\n');
end

% Gradient at rest (should be zero since F=0)
gw=-2*y*F1+2*x*F2-2*w*F3;
gx_= 2*z*F1+2*w*F2+2*x*F3;
gy_=-2*w*F1+2*z*F2+2*y*F3;
gz_= 2*x*F1+2*y*F2-2*z*F3;
fprintf('  Gradient at rest: [%.6f %.6f %.6f %.6f] (all must be 0)\n\n',gw,gx_,gy_,gz_);

% az_world at rest
R31=2.0*(w*y - x*z); R32=2.0*(y*z + w*x); R33=w^2-x^2-y^2+z^2;
az_world = R31*ax + R32*ay + R33*az;
fprintf('  az_world=%.4f  (expect %.4f = -g)\n', az_world, -g);
fprintf('  a_up = -(az_world+g) = %.4f  (expect 0)\n\n', -(az_world+g));

%% =========================================================
%  TEST 2 — 10 deg nose-up pitch, sensor at rest
%  Body pitched up by theta=10 deg:
%    R_bn = Ry(theta) = [cos(t) 0 sin(t); 0 1 0; -sin(t) 0 cos(t)]
%    gravity in body = R_bn' * [0;0;g] = [-sin(t)*g; 0; cos(t)*g]
%    sensor reads f_body = -gravity_in_body = [sin(t)*g; 0; -cos(t)*g]
%    normalised: [sin(t); 0; -cos(t)]
% ==========================================================
fprintf('--- TEST 2: 10 deg pitch-up, at rest ---\n');
theta_deg = 10;
theta_rad = theta_deg * pi/180;

% Quaternion for pure pitch (rotation about body Y = NED Y):
% q = [cos(t/2), 0, sin(t/2), 0]
q_pitch = [cos(theta_rad/2), 0, sin(theta_rad/2), 0];
fprintf('  q_pitch = [%.4f %.4f %.4f %.4f]\n', q_pitch);

% Expected sensor reading
ax_expect =  sin(theta_rad) * g;
ay_expect =  0;
az_expect = -cos(theta_rad) * g;
fprintf('  Expected accel: [%.4f, %.4f, %.4f] m/s²\n', ax_expect, ay_expect, az_expect);
fprintf('  Normalised:     [%.4f, %.4f, %.4f]\n', ax_expect/g, ay_expect/g, az_expect/g);

ax=ax_expect; ay=ay_expect; az=az_expect;
an=sqrt(ax^2+ay^2+az^2);
axn=ax/an; ayn=ay/an; azn=az/an;

w=q_pitch(1); x=q_pitch(2); y=q_pitch(3); z=q_pitch(4);
F1 = -2.0*(w*y - x*z) - axn;   % R31 = 2(wy-xz), expected = -R31
F2 = -2.0*(y*z + w*x) - ayn;   % R32 = 2(yz+wx), expected = -R32
F3=-(w^2-x^2-y^2+z^2)-azn;
fprintf('  F = [%.6f, %.6f, %.6f]  (all must be 0 — q is correct)\n', F1,F2,F3);
if abs(F1)<1e-6 && abs(F2)<1e-6 && abs(F3)<1e-6
    fprintf('  TEST 2: PASS\n\n');
else
    fprintf('  TEST 2: FAIL\n\n');
end

% az_world
R31=2.0*(w*y - x*z); R32=2.0*(y*z + w*x); R33=w^2-x^2-y^2+z^2;
az_world = R31*ax + R32*ay + R33*az;
fprintf('  az_world=%.4f  (expect %.4f = -g)\n', az_world, -g);
fprintf('  (az_world should always be -g at rest regardless of attitude)\n\n');

%% =========================================================
%  TEST 3 — Gradient direction test
%  Start from identity q. Feed accel for 5-deg roll-right tilt.
%  The gradient should push the quaternion TOWARD the rolled state,
%  meaning the roll component (q_x) should increase.
%
%  5 deg roll right: accel = [0, sin(5deg)*g, -cos(5deg)*g]
%  Quaternion for 5 deg roll: q = [cos(2.5deg), sin(2.5deg), 0, 0]
% ==========================================================
fprintf('--- TEST 3: gradient direction for 5-deg roll ---\n');
roll_deg = 5;
roll_rad = roll_deg * pi/180;

% Accel for a sensor tilted 5 deg right (body Z down, right wing down)
ax_tilt =  0;
ay_tilt =  sin(roll_rad) * g;
az_tilt = -cos(roll_rad) * g;
an = sqrt(ax_tilt^2+ay_tilt^2+az_tilt^2);
axn=ax_tilt/an; ayn=ay_tilt/an; azn=az_tilt/an;
fprintf('  Accel for 5-deg right roll (normalised): [%.4f, %.4f, %.4f]\n',axn,ayn,azn);

% Start from identity (wrong — filter thinks it is level)
q = [1 0 0 0];
w=q(1); x=q(2); y=q(3); z=q(4);
F1 = -2.0*(w*y - x*z) - axn;   % R31 = 2(wy-xz), expected = -R31
F2 = -2.0*(y*z + w*x) - ayn;   % R32 = 2(yz+wx), expected = -R32
F3=-(w^2-x^2-y^2+z^2)-azn;
gw=-2*y*F1+2*x*F2-2*w*F3;
gx_= 2*z*F1+2*w*F2+2*x*F3;
gy_=-2*w*F1+2*z*F2+2*y*F3;
gz_= 2*x*F1+2*y*F2-2*z*F3;
fprintf('  F = [%.4f, %.4f, %.4f]\n', F1, F2, F3);
fprintf('  Gradient (unnorm) = [%.4f, %.4f, %.4f, %.4f]\n', gw,gx_,gy_,gz_);

% For a right roll, the correct quaternion has x = sin(roll/2) > 0.
% The gradient-DESCENT step is:  q_new = q - beta * grad_norm
% So for q_x to increase (move toward correct), we need:
%   q_x_new = q_x - beta*grad_x_norm  =>  need grad_x_norm < 0
%
% Check: after normalisation, is grad_x negative?
gn=sqrt(gw^2+gx_^2+gy_^2+gz_^2); if gn<1e-10, gn=1; end
gw_n=gw/gn; gx_n=gx_/gn; gy_n=gy_/gn; gz_n=gz_/gn;
fprintf('  Normalised gradient = [%.4f, %.4f, %.4f, %.4f]\n', gw_n,gx_n,gy_n,gz_n);
fprintf('  For RIGHT roll correction: grad_x_norm must be NEGATIVE (so q_x increases)\n');
fprintf('  grad_x_norm = %.4f  => ', gx_n);
if gx_n < 0
    fprintf('CORRECT direction (gradient descent increases q_x)\n');
else
    fprintf('WRONG direction! (gradient descent decreases q_x — SIGN ERROR)\n');
end

% Also verify: correct target quaternion for 5-deg roll
q_correct = [cos(roll_rad/2), sin(roll_rad/2), 0, 0];
fprintf('  Correct q for 5-deg roll: [%.4f, %.4f, %.4f, %.4f]\n', q_correct);
fprintf('  q_x should be positive (%.4f) after correction\n\n', q_correct(2));

%% =========================================================
%  TEST 4 — Simulate 50 steps from identity with 5-deg roll accel
%  The filter should converge toward the correct roll angle.
%  If it diverges (roll goes negative), the sign is flipped.
% ==========================================================
fprintf('--- TEST 4: 50-step convergence from identity, 5-deg roll ---\n');
q   = [1 0 0 0];
gb  = [0 0 0];
beta_test = 0.1;
zeta_test = 0.0;   % no bias correction for this test
dt_test   = 1/52;

ax=ax_tilt; ay=ay_tilt; az=az_tilt;   % constant 5-deg roll accel
an=sqrt(ax^2+ay^2+az^2);
axn=ax/an; ayn=ay/an; azn=az/an;

for step = 1:50
    w=q(1); x=q(2); y=q(3); z=q(4);
    F1 = -2.0*(w*y - x*z) - axn;   % R31 = 2(wy-xz), expected = -R31
    F2 = -2.0*(y*z + w*x) - ayn;   % R32 = 2(yz+wx), expected = -R32
    F3=-(w^2-x^2-y^2+z^2)-azn;
    gw=-2*y*F1+2*x*F2-2*w*F3;
    gx_= 2*z*F1+2*w*F2+2*x*F3;
    gy_=-2*w*F1+2*z*F2+2*y*F3;
    gz_= 2*x*F1+2*y*F2-2*z*F3;
    gn=sqrt(gw^2+gx_^2+gy_^2+gz_^2); if gn<1e-10,gn=1; end
    gw=gw/gn; gx_=gx_/gn; gy_=gy_/gn; gz_=gz_/gn;
    % No gyro: pure gradient descent
    qdw=-beta_test*gw; qdx=-beta_test*gx_; qdy=-beta_test*gy_; qdz=-beta_test*gz_;
    w=w+qdw*dt_test; x=x+qdx*dt_test; y=y+qdy*dt_test; z=z+qdz*dt_test;
    qn=sqrt(w^2+x^2+y^2+z^2); if qn<1e-6,qn=1; end
    q=[w x y z]/qn;
end

% Extract roll from converged quaternion
w=q(1); x=q(2); y=q(3); z=q(4);
roll_converged = atan2(2*(w*x+y*z), 1-2*(x^2+y^2)) * 180/pi;
fprintf('  After 50 steps, roll = %.2f deg  (expect +%.1f)\n', roll_converged, roll_deg);
if abs(roll_converged - roll_deg) < 1.0
    fprintf('  TEST 4: PASS — gradient descent converges correctly\n\n');
elseif abs(roll_converged + roll_deg) < 1.0
    fprintf('  TEST 4: FAIL — converged to WRONG sign (gradient ascent!)\n\n');
else
    fprintf('  TEST 4: FAIL — did not converge (roll=%.2f, expected %.2f)\n\n', roll_converged, roll_deg);
end

%% =========================================================
%  TEST 5 — Same as Test 4 but for pitch-up
% ==========================================================
fprintf('--- TEST 5: 50-step convergence from identity, 5-deg pitch-up ---\n');
pitch_deg = 5;
pitch_rad = pitch_deg * pi/180;
ax_p =  sin(pitch_rad)*g;
ay_p =  0;
az_p = -cos(pitch_rad)*g;
an=sqrt(ax_p^2+ay_p^2+az_p^2);
axn=ax_p/an; ayn=ay_p/an; azn=az_p/an;

q=[1 0 0 0];
for step=1:50
    w=q(1); x=q(2); y=q(3); z=q(4);
    F1=-2*(x*z+w*y)-axn; F2=-2*(y*z-w*x)-ayn; F3=-(w^2-x^2-y^2+z^2)-azn;
    gw=-2*y*F1+2*x*F2-2*w*F3;
    gx_= 2*z*F1+2*w*F2+2*x*F3;
    gy_=-2*w*F1+2*z*F2+2*y*F3;
    gz_= 2*x*F1+2*y*F2-2*z*F3;
    gn=sqrt(gw^2+gx_^2+gy_^2+gz_^2); if gn<1e-10,gn=1; end
    gw=gw/gn; gx_=gx_/gn; gy_=gy_/gn; gz_=gz_/gn;
    qdw=-beta_test*gw; qdx=-beta_test*gx_; qdy=-beta_test*gy_; qdz=-beta_test*gz_;
    w=w+qdw*dt_test; x=x+qdx*dt_test; y=y+qdy*dt_test; z=z+qdz*dt_test;
    qn=sqrt(w^2+x^2+y^2+z^2); if qn<1e-6,qn=1; end
    q=[w x y z]/qn;
end
w=q(1); x=q(2); y=q(3); z=q(4);
pitch_converged = atan2(2*(w*x+y*z),1-2*(x^2+y^2)) * 180/pi;
sp_=max(-1,min(1,2*(w*q(3)-q(4)*x)));
pitch_converged = asin(sp_) * 180/pi;
fprintf('  After 50 steps, pitch = %.2f deg  (expect +%.1f)\n', pitch_converged, pitch_deg);
if abs(pitch_converged - pitch_deg) < 1.0
    fprintf('  TEST 5: PASS\n\n');
elseif abs(pitch_converged + pitch_deg) < 1.0
    fprintf('  TEST 5: FAIL — converged to wrong sign\n\n');
else
    fprintf('  TEST 5: FAIL — did not converge\n\n');
end

%% =========================================================
%  TEST 6 — az_world during a known tilt
%  With 10-deg pitch-up and gyro = 0, az_world must still equal -g
%  (the vertical component of specific force is always -g at rest
%   regardless of tilt — that is the whole point of the rotation)
% ==========================================================
fprintf('--- TEST 6: az_world at 10-deg pitch, at rest ---\n');
q = [cos(theta_rad/2), 0, sin(theta_rad/2), 0];   % 10-deg pitch-up
ax = sin(theta_rad)*g; ay = 0; az = -cos(theta_rad)*g;   % sensor reading
w=q(1); x=q(2); y=q(3); z=q(4);
R31=2.0*(w*y - x*z); R32=2.0*(y*z + w*x); R33=w^2-x^2-y^2+z^2;
az_world = R31*ax + R32*ay + R33*az;
fprintf('  az_world = %.6f  (expect %.6f)\n', az_world, -g);
fprintf('  error    = %.2e  (must be < 1e-10)\n', abs(az_world - (-g)));
if abs(az_world - (-g)) < 1e-6
    fprintf('  TEST 6: PASS\n\n');
else
    fprintf('  TEST 6: FAIL — R_bn row 3 is wrong\n\n');
end

%% =========================================================
%  SUMMARY
% ==========================================================
fprintf('=== Summary ===\n');
fprintf('If Tests 1-2-6 pass but 3-4-5 fail: sign error in gradient (J^T*F)\n');
fprintf('If Tests 1-2 fail:                   sign error in objective function F\n');
fprintf('If Tests 1-6 all pass:               filter math is correct, problem is elsewhere\n');
fprintf('If Test 6 fails:                     sign error in R_bn row 3 (az_world output)\n');